{
  "manifest_version": 3,
  "name": "Job Finder Apply",
  "version": "0.1.0",
  "description": "Fills job applications for Sherif from the local Job Finder app.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "http://localhost:3100/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://*.workable.com/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "Job Finder"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
